  ],
  "outputs": [
    { "path": "bin/agent-cli", "mode": 493 },
    { "path": "bin/agent-service", "mode": 493 },
    { "path": "bin/agent-identity", "mode": 493 },
    { "path": "bin/fdn-service", "mode": 493 },
    { "path": "THIRD_PARTY_NOTICES", "mode": 420 }
  ],
  "dependencies": []
}
